# The production layout on one local origin, http://localhost:8080.
# local/up.mjs sets SPARCD_REPO. Plain HTTP, so no certificates.

{
	admin off
	auto_https off
}

http://:8080 {
	bind 127.0.0.1

	# Host is part of the signature, so it goes to the gate unchanged.
	handle /-/* {
		reverse_proxy 127.0.0.1:8787 {
			header_up Host {http.request.hostport}
		}
	}
	handle /sparcd-next-* {
		reverse_proxy 127.0.0.1:8787 {
			header_up Host {http.request.hostport}
		}
	}

	redir /upload /upload/
	handle_path /upload/* {
		root * {$SPARCD_REPO}/apps/uploader/dist
		try_files {path} /index.html
		file_server
	}

	redir /tag /tag/
	handle_path /tag/* {
		root * {$SPARCD_REPO}/apps/tagger/dist
		try_files {path} /index.html
		file_server
	}

	handle {
		root * {$SPARCD_REPO}/apps/sparcd-home
		file_server
	}
}
