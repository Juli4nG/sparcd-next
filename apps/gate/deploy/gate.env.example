# /etc/sparcd-next/gate.env, root:root 0600. install.sh writes it once with a
# fresh ACCESS_MASTER_KEY and DATA_KEY; fill in the upstream and the project key.
# Keep a copy of DATA_KEY somewhere safe and offline: without it every stored
# photo and table is unreadable.
UPSTREAM=https://objects.example.org:8080
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
ACCESS_MASTER_KEY=
DATA_KEY=
SETTINGS_BUCKET=sparcd-next-settings
BUCKET_ALLOW=sparcd-next-*
# The 443 site plus the upload shards on 8443-8449, which sign host:port.
ALLOWED_HOSTS=server.example.org,server.example.org:8443,server.example.org:8444,server.example.org:8445,server.example.org:8446,server.example.org:8447,server.example.org:8448,server.example.org:8449
PORT=8787
# Uncomment if the upstream's certificate chain fails with Node's bundled CAs.
# NODE_OPTIONS=--use-system-ca
